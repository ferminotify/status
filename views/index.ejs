<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Fermi Notify Status</title>
	<!-- jquery -->
	<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
	<!-- icons -->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
	<script src="https://kit.fontawesome.com/95ae55bd9a.js" crossorigin="anonymous"></script>
	<link rel="stylesheet" href="/css/style.css"/>
	<link rel="stylesheet" href="/css/alertbanner.css"/>
	<link rel="stylesheet" href="/css/btn.css"/>
	<link rel="stylesheet" href="/css/mirror.css"/>
	<link rel="stylesheet" href="/css/webapp.css"/>
</head>
<body>
	<div class="container" style="width: 100%; height: 100dvh;">
		<div class="grid-2-col container-2-block" style="height: 100%; margin: 15px; gap: 15px;">
			<div class="webapp-container" style="height: 100%; width: 100%; max-height: calc(100dvh - 30px);">
				<div class="webapp" style="width: 100%; height: 100%">
					<%- include('includes/webapp.ejs'); %>	
				</div>
				<div class="mirror" style="width: 100%;">
					<%- include('includes/mirror.ejs'); %>
				</div>
			</div>
			<div class="notifier" style="height: 100%; width: 100%;">
				<%- include('includes/notifier.ejs'); %>
			</div>
		</div>
	</div>

	<!-- flash messages -->
	<% if(error) { %>
		<% error.forEach(error => { %>
			<div id="alertbanner" class="errorbanner">
				<p id="alertmessage"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></p>
			</div>
			<script>
				document.getElementById("alertbanner").style.animation = "showAlert 0.5s ease-in-out forwards";
				document.getElementById("alertbanner").addEventListener("click", function() {
					document.getElementById("alertbanner").style.animation = "hideAlert 0.5s ease-in-out forwards";
				});
			</script>
		<% }) %>
	<% } %>
	<% if(success) { %>
		<% success.forEach(success => { %>
			<div id="alertbanner" class="successbanner">
				<p id="alertmessage"><i class="fa-solid fa-check"></i> <%= success %></p>
			</div>
			<script>
				document.getElementById("alertbanner").style.animation = "showAlert 0.5s ease-in-out forwards";
				document.getElementById("alertbanner").addEventListener("click", function() {
					document.getElementById("alertbanner").style.animation = "hideAlert 0.5s ease-in-out forwards";
				});
			</script>
		<% }) %>
	<% } %>

	
<script>
	// device width smaller than 830px
	var mirror_open = false;
	// onclick on .mirror --> show all .domain span slide left to right
	$('.mirror').click(function() {
		if (window.innerWidth < 830) {
			$('.domain span').animate({width: 'toggle'}, 350);
			mirror_open = !mirror_open;
		}
	});
	$('.summary').click(function() {
		if (window.innerWidth < 830) {
			if (mirror_open) {
				$('.domain span').animate({width: 'toggle'}, 350);
				mirror_open = !mirror_open;
			}
		}
	});
</script>
</body>
</html>